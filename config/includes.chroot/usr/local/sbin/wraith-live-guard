#!/bin/bash
# Wraith Live amnesia guard. Runs at boot in Wraith Live (and the installer session).
#  - turns off any swap so nothing from RAM is ever written to a disk
#  - copies a tiny watcher into RAM that powers the machine off the moment the
#    boot USB is pulled out; memory is zeroed as processes exit (init_on_free=1)
set -euo pipefail

grep -qw 'wraith.mode=live\|wraith.mode=install' /proc/cmdline || exit 0

swapoff -a || true

# Everything the watcher needs lives in RAM, because the USB it was loaded
# from will be gone when it has to act.
# /run is mounted noexec, so the watcher gets a small RAM disk of its own.
G=/run/wraith-guard
mkdir -p "$G"
mountpoint -q "$G" || mount -t tmpfs -o mode=0700,size=8m,nosuid,nodev,exec wraith-guard "$G"
cp /bin/busybox "$G/busybox"   # (busybox picks the applet from its own file name)

# Nothing to watch: keep the service running but idle (never power off).
idle() {
    echo "wraith-live-guard: $1, not watching the boot medium"
    printf 'while :; do %s/busybox sleep 3600; done\n' "$G" > "$G/watch.sh"
    exit 0
}

# "Copy to RAM, then remove the USB": pulling it out is the whole point.
grep -qw toram /proc/cmdline && idle "running from RAM"

SRC=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)
[ -n "$SRC" ] || idle "boot medium not found"
DISK=$(lsblk -no PKNAME "$SRC" 2>/dev/null | head -n1)
[ -n "$DISK" ] || DISK=$(basename "$SRC")
# Only ever watch a real block device - a missing one would power off at once.
[ -e "/sys/block/$DISK" ] || idle "boot medium $SRC is not a disk"

cat > "$G/watch.sh" <<EOF
while [ -e /sys/block/$DISK ]; do $G/busybox sleep 1; done
echo e > /proc/sysrq-trigger
$G/busybox sleep 2
echo i > /proc/sysrq-trigger
$G/busybox sleep 1
echo o > /proc/sysrq-trigger
EOF
echo "wraith-live-guard: watching /dev/$DISK"
