#!/bin/bash
# Starts the Wraith desktop shell (bar, dock, app drawer, quick settings, wallpaper).
# libgtk4-layer-shell must be loaded before libwayland-client, so preload it.
lib=$(ldconfig -p | awk '/libgtk4-layer-shell\.so\.0 /{print $NF; exit}')
[ -n "$lib" ] && export LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}"
# Keep running: if the shell crashes, bring it back - but only while the
# desktop session is still there, and not in a tight loop.
crashes=0
while :; do
    started=$(date +%s)
    python3 /usr/share/wraith/shell/host/shell.py "$@"
    status=$?
    [ $status -eq 0 ] && exit 0
    [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-wayland-0}" ] || exit 0   # session ended
    [ $(( $(date +%s) - started )) -lt 20 ] && crashes=$((crashes + 1)) || crashes=0
    [ $crashes -ge 5 ] && { echo "wraith-shell keeps crashing, giving up" >&2; exit 1; }
    echo "wraith-shell exited ($status), restarting in 1 s" >&2
    sleep 1
done
