#!/usr/bin/python3
"""wraith-shell-ctl drawer|qs|close|refresh - poke the running Wraith shell."""
import os, socket, sys
cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd not in ("drawer", "qs", "close", "refresh"):
    sys.exit("usage: wraith-shell-ctl drawer|qs|close|refresh")
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect(os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "wraith-shell.sock"))
    s.sendall(cmd.encode())
except OSError as e:
    sys.exit(f"wraith-shell is not running ({e})")
