#!/bin/sh
# Starts the Wraith installer (Calamares) as root on the desktop.
# Root needs the session's Wayland socket to draw, so pass it through. Wraith
# Live gives the live user password-free sudo until an admin password is set in
# Welcome; after that, ask for the password through polkit.
set -- env WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    DISPLAY="${DISPLAY:-}" XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM="wayland;xcb" calamares "$@"
if sudo -n true 2>/dev/null; then
    exec sudo -n "$@"
fi
exec pkexec "$@"
