#!/bin/sh
# Starts the Wraith installer (Calamares) as root on the desktop.
# Root needs the session's Wayland socket to draw, so pass it through. Wraith
# Live gives the live user password-free sudo until an admin password is set in
# Welcome; after that, ask for the password through polkit.
# qt6ct gives the installer Wraith's dark colours (root has no theme of its own).
# LVM: the live system switches on volume groups it finds on the disks (an old
# Ubuntu install's "ubuntu-vg"), and Calamares then lists such a group as if it
# were a disk - installing to it fails. Switch them off (nothing uses them) and
# let the installer's LVM see no devices, so only real disks are offered.
set -- env WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    DISPLAY="${DISPLAY:-}" XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM="wayland;xcb" \
    QT_QPA_PLATFORMTHEME=qt6ct XDG_CONFIG_HOME="${WRAITH_INSTALLER_QT:-/usr/share/wraith/installer-qt}" \
    LVM_SYSTEM_DIR_NEW="${WRAITH_INSTALLER_LVM:-/usr/share/wraith/installer-lvm}" \
    sh -c 'vgchange -an >/dev/null 2>&1; export LVM_SYSTEM_DIR="$LVM_SYSTEM_DIR_NEW"; unset LVM_SYSTEM_DIR_NEW; exec calamares "$@"' calamares "$@"
if sudo -n true 2>/dev/null; then
    exec sudo -n "$@"
fi
exec pkexec "$@"
